{
  "name": "storybook-addon-zod-schemas",
  "version": "0.1.0",
  "description": "Auto-generate Zod schemas and Pydantic models from Storybook ArgTypes for LLM tool calling",
  "keywords": [
    "storybook",
    "addon",
    "zod",
    "pydantic",
    "schema",
    "llm",
    "ai",
    "tool-calling"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./manager": "./dist/manager.js",
    "./preset": "./dist/preset.js"
  },
  "bin": {
    "zod-schemas-gen": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@storybook/components": "^8.4.0",
    "@storybook/icons": "^1.3.0",
    "@storybook/manager-api": "^8.4.0",
    "@storybook/preview-api": "^8.4.0",
    "@storybook/types": "^8.4.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@storybook/components": "^8.0.0",
    "@storybook/manager-api": "^8.0.0",
    "@storybook/preview-api": "^8.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "commander": "^14.0.3",
    "glob": "^13.0.6"
  }
}
